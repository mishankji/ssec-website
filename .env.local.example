# Copy this file to .env.local and fill in real values. .env.local is
# gitignored, so it never gets committed.

# Powers the Contact page's form (src/app/api/contact/route.ts).
# Get a key at https://resend.com after signing up (free tier available).
RESEND_API_KEY=

# Supabase project -- powers employee login (src/lib/supabase, src/middleware.ts).
# Find these under Project Settings > API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Sheets access via OAuth (see scripts/get-google-refresh-token.mjs).
# GOOGLE_OAUTH_CLIENT_ID / GOOGLE_OAUTH_CLIENT_SECRET come from a "Desktop app"
# OAuth client in Google Cloud Console (APIs & Services > Credentials).
# GOOGLE_OAUTH_REFRESH_TOKEN is produced once by running: npm run google:auth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Form-6 spreadsheet ID (from its URL: https://docs.google.com/spreadsheets/d/<ID>/edit).
# See src/lib/google-sheets.ts.
GOOGLE_SHEETS_FORM6_ID=

# Optional. Full site URL (no trailing slash), used only to build a
# clickable "review it here" link in the approver notification email (see
# src/lib/notify-approvers.ts). Leave blank locally; set it to your Vercel
# URL (e.g. https://ssec-website-cyan.vercel.app) once deployed.
NEXT_PUBLIC_SITE_URL=
